{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@raptor/dom"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "examples/*/src/**/*.ts",
    "examples/*/src/**/*.tsx",
    "examples/*/tests/**/*.ts"
  ]
}
