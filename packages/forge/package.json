{
  "name": "@raptor/forge",
  "version": "0.1.0",
  "description": "RaptorForge: project generator and target contracts for web, desktop and mobile Raptor applications.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
