{
  "name": "raptor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "RaptorJS + RaptorWire - compiler-centric fine-grained UI + state-aware binary protocol (MVP v0.1)",
  "author": "cristibcf (https://github.com/cristibcf)",
  "homepage": "https://github.com/cristibcf/raptorjs#readme",
  "bugs": "https://github.com/cristibcf/raptorjs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristibcf/raptorjs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test \"packages/*/tests/**/*.test.ts\" \"examples/*/tests/**/*.test.ts\"",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "prepublish:check": "pnpm -r --filter \"./packages/*\" publish --dry-run --no-git-checks",
    "test:core": "node --test packages/raptorjs/tests/core/*.test.ts",
    "test:codec": "node --test packages/wire/tests/codec/*.test.ts",
    "test:wire": "node --test packages/wire/tests/core/*.test.ts",
    "typecheck": "npm run typecheck:node && npm run typecheck:native",
    "typecheck:node": "tsc --noEmit -p tsconfig.json",
    "typecheck:native": "tsc --noEmit -p tsconfig.native.json",
    "stats": "node tools/stats.ts",
    "stats:check": "node tools/stats.ts --check",
    "bump": "node tools/bump.ts",
    "demo:counter": "node examples/counter/src/demo.ts",
    "demo:dashboard": "node examples/realtime-dashboard/src/demo.ts",
    "demo:chat": "node examples/chat/src/demo.ts",
    "demo:raptortest": "node examples/raptortest-crud/src/demo.ts",
    "demo:engine": "node examples/raptorengine-app/src/demo.ts",
    "demo:run": "node examples/raptorengine-app/src/run-demo.ts",
    "demo:profile": "node examples/raptorengine-app/src/profile-demo.ts",
    "demo:desktop": "node examples/desktop-shell/src/demo.ts",
    "demo:mobile": "node examples/mobile-shell/src/demo.ts",
    "demo:web-host": "node examples/web-shell/src/demo.ts",
    "demo:service": "node examples/service-shell/src/demo.ts",
    "demo:cli": "node examples/cli-shell/src/demo.ts",
    "demo:device": "node examples/device-shell/src/demo.ts",
    "notes": "node examples/cli-shell/src/bin.ts",
    "raptor": "node packages/engine/src/engine/bin.ts",
    "raptor:run": "node packages/engine/src/run/bin.ts",
    "raptor:dev": "node packages/engine/src/run/bin.ts dev",
    "raptor:profile": "node packages/engine/src/profile/bin.ts",
    "raptor:create": "node packages/engine/src/forge/bin.ts",
    "raptor:runtime": "node packages/runtime/src/cli/bin.ts",
    "bundle": "node packages/engine/src/bundle/bin.ts",
    "dev:counter": "pnpm --filter @raptor-example/counter dev",
    "dev:dashboard": "pnpm --filter @raptor-example/realtime-dashboard dev",
    "dev:site": "pnpm --filter @raptor-example/site dev",
    "dev:todo": "pnpm --filter @raptor-example/todo-realtime dev",
    "dev:web-shell": "pnpm --filter @raptor-example/web-shell dev",
    "build:site": "pnpm --filter @raptor-example/site build",
    "verify:rolldown": "cd integrations/rolldown && node verify.ts",
    "runtime": "node packages/runtime/src/cli/bin.ts",
    "runtime:doctor": "node packages/runtime/src/cli/bin.ts doctor",
    "spike": "pnpm --filter @raptor-example/raptor-runtime-spike spike",
    "spike:checks": "pnpm --filter @raptor-example/raptor-runtime-spike spike:checks",
    "test:runtime": "node --test packages/runtime/tests/core/*.test.ts packages/runtime/tests/cli/*.test.ts",
    "native": "wsl -d Ubuntu -u root -- bash /mnt/c/Users/crist/projects/raptorjs/packages/runtime-native/scripts/cargo-wsl.sh",
    "native:test": "wsl -d Ubuntu -u root -- bash /mnt/c/Users/crist/projects/raptorjs/packages/runtime-native/scripts/cargo-wsl.sh test",
    "native:lint": "wsl -d Ubuntu -u root -- bash /mnt/c/Users/crist/projects/raptorjs/packages/runtime-native/scripts/cargo-wsl.sh clippy --all-targets -- -D warnings",
    "native:parity": "wsl -d Ubuntu -u root -- bash /mnt/c/Users/crist/projects/raptorjs/packages/runtime-native/scripts/compare-pack.sh"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
