{
  "name": "@raptor-example/web-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example: the same RaptorJS app as desktop-shell and mobile-shell, with the browser as host (roadmap section 4: for the web target, the host is the browser).",
  "dependencies": {
    "raptorjs": "workspace:*",
    "@raptor/host": "workspace:*"
  },
  "devDependencies": {
    "@raptor/engine": "workspace:*"
  },
  "scripts": {
    "demo": "node src/demo.ts",
    "dev": "raptor-bundle dev src/main.tsx --root . --port 5174",
    "build": "raptor-bundle build src/main.tsx --out dist/bundle.js --html index.html",
    "test": "node --test tests/*.test.ts"
  }
}
