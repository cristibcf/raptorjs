{
  "name": "@raptor-example/realtime-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end MVP: server signals + RaptorWire delta ops + reactive client + fine-grained DOM.",
  "dependencies": {
    "raptorjs": "workspace:*",
    "@raptor/wire": "workspace:*"
  },
  "devDependencies": {
    "@raptor/engine": "workspace:*"
  },
  "scripts": {
    "demo": "node src/demo.ts",
    "dev": "raptor-bundle dev src/main.tsx --root . --port 5173",
    "build": "raptor-bundle build src/main.tsx --out dist/bundle.js --html index.html",
    "test": "node --test tests/*.test.ts"
  }
}
