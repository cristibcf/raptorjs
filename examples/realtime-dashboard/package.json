{
  "name": "@raptor-example/realtime-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP end-to-end: server signals + RaptorWire delta ops + client reactiv + DOM fine-grained.",
  "dependencies": {
    "@raptor/core": "workspace:*",
    "@raptor/dom": "workspace:*",
    "@raptor/wire-core": "workspace:*",
    "@raptor/wire-client": "workspace:*",
    "@raptor/server": "workspace:*"
  },
  "devDependencies": {
    "@raptor/bundle": "workspace:*"
  },
  "scripts": {
    "demo": "node src/demo.ts",
    "dev": "raptor-bundle dev src/main.tsx --root . --port 5173",
    "build": "raptor-bundle build src/main.tsx --out dist/bundle.js --html index.html",
    "test": "node --test tests/*.test.ts"
  }
}
